
import heapq
from itertools import count

def huffman_codes(freq):
    serial = count()

    heap = [
        (frequency, next(serial), character)
        for character, frequency in freq.items()
    ]
    heapq.heapify(heap)

    if len(heap) == 1:
        return {heap[0][2]: "0"}

    while len(heap) > 1:
        f1, _, left = heapq.heappop(heap)
        f2, _, right = heapq.heappop(heap)

        heapq.heappush(
            heap,
            (f1 + f2, next(serial), (left, right))
        )

    root = heap[0][2]
    codes = {}

    def generate(node, code):
        if isinstance(node, str):
            codes[node] = code
        else:
            generate(node[0], code + "0")
            generate(node[1], code + "1")

    generate(root, "")
    return codes


frequency = {
    'a': 5,
    'b': 9,
    'c': 12,
    'd': 13,
    'e': 16,
    'f': 45
}

codes = huffman_codes(frequency)

for char, code in sorted(codes.items()):
    print(char, "->", code)
